    if (!el.length) { H.ch = null; return; }
    if (H.mode === "teams") {
      const nt = H.teams.length, start = H.ch ? H.ch.t : -1;
      for (let k = 1; k <= nt; k++) { const t = (start + k) % nt; if (el.some(id => teamOf(id) === t)) { H.ch = { t }; return; } }
    } else {
      const n = H.order.length, i = H.ch ? H.order.indexOf(H.ch.p) : -1;
      for (let k = 1; k <= n; k++) { const id = H.order[(i + k) % n]; if (el.includes(id)) { H.ch = { p: id }; return; } }
    }
  }
  function chooserLabel() {
    if (!H.ch) return "the host";
    return H.mode === "teams" ? H.teams[H.ch.t] : (H.P[H.ch.p] ? H.P[H.ch.p].n : "a player");
  }

  function startGame() { H.round = 1; H.ch = null; advanceChooser(); H.phase = "choose"; H.A = {}; pushHost(); }
  function startQuestion(k) { H.q = k; H.phase = "question"; H.left = H.timer; H.A = {}; H.dist = null; pushHost(); }
  function reveal() {
    const isF = H.phase === "final_q";
    const { q, v } = clue(isF ? "F" : H.q);
    const dist = [0, 0, 0, 0, 0];
    H.last = {};
    for (const id in H.P) {
      const c = H.A[id];
      const stake = isF ? (H.W[id] || 0) : v;
      let d = 0;
      if (c != null) { dist[c]++; d = c === q.a ? stake : -stake; }
      H.P[id].s += d; H.last[id] = d;
    }
    H.dist = dist; H.left = 0;
    if (!isF) H.used = H.used.slice(0, tileIdx(H.q)) + "1" + H.used.slice(tileIdx(H.q) + 1);
