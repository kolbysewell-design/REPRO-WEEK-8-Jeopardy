    }
    return H.order.map(id => ({ name: H.P[id].n, sub: "", s: H.P[id].s, d: H.last[id] || 0, on: online(id), turn: H.ch && H.ch.p === id })).sort((a, b) => b.s - a.s);
  }

  function pushHost() {
