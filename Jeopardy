  }

  /* chooser: {t: teamIndex} in teams mode, {p: pid} in players mode */
  function isChooser(id) { if (!H.ch) return false; return H.mode === "teams" ? teamOf(id) === H.ch.t : id === H.ch.p; }
  function chooserValid() { return H.ch && eligiblePids().some(isChooser); }
  function advanceChooser() {
