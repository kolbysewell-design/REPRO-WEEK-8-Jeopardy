<style>
  /* Layout: home (host or join) -> host big-screen view (code bar, board/question stage, standings rail) or phone controller view. Same teal felt + gold identity as the read-aloud boards. */
  :root {
    --board-bg: #0b2e33; --board-bg-2: #123840; --board-line: #1c4650; --board-hover: #1a4c56;
    --gold: #e8b94b; --gold-hi: #f2c765; --gold-dim: #c99a35; --coral: #e4633f; --sage: #7fae8e;
    --ink-light: #f5f1e6; --ink-light-dim: #cfe4e2;
    --on-gold: #1b1408; --on-sage: #0e2015; --on-coral: #2a0d05;
    --ok-bg: rgba(127,174,142,.22); --bad-bg: rgba(228,99,63,.22);
    --page-bg: #eee7d6; --panel-bg: #faf7f0; --panel-line: #ddd3ba;
    --text-main: #16221f; --text-dim: #5a6a64; --shadow: rgba(11, 46, 51, 0.25); --focus: #2f7d8c;
    --f-display: "Fraunces", Georgia, serif;
    --f-body: "IBM Plex Sans", -apple-system, "Segoe UI", sans-serif;
    --f-mono: "IBM Plex Mono", "SF Mono", ui-monospace, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --page-bg: #0a1615; --panel-bg: #10201f; --panel-line: #1f3634;
      --text-main: #f2ede0; --text-dim: #9fb3ad; --shadow: rgba(0,0,0,.5); --focus: #5fb0bf; color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --page-bg: #0a1615; --panel-bg: #10201f; --panel-line: #1f3634;
    --text-main: #f2ede0; --text-dim: #9fb3ad; --shadow: rgba(0,0,0,.5); --focus: #5fb0bf; color-scheme: dark;
  }
  * { box-sizing: border-box; }
  body { background: var(--page-bg); color: var(--text-main); font-family: var(--f-body); font-size: 15px; line-height: 1.5;
    padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 20px 40px; }
  button, input, select { font-family: inherit; font-size: inherit; }
  button:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .wrap { max-width: 1240px; margin: 0 auto; display: flex; flex-direction: column; gap: 18px; }
  .eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: .72rem; color: var(--gold-dim); font-weight: 600; margin: 0; }
  h1, h2, h3 { font-family: var(--f-display); font-weight: 600; margin: 0; text-wrap: balance; }
  h1 { font-size: clamp(1.7rem, 4.4vw, 2.6rem); line-height: 1.1; }
  h2 { font-size: 1.25rem; }
  .dim { color: var(--text-dim); }
  .tnum { font-family: var(--f-mono); font-variant-numeric: tabular-nums; }

  /* home */
  .home-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
  .card { background: var(--panel-bg); border: 1px solid var(--panel-line); border-radius: 14px; padding: 20px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 2px 8px var(--shadow); min-width: 0; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label, .lbl { font-size: .74rem; text-transform: uppercase; letter-spacing: .1em; font-weight: 600; color: var(--text-dim); }
  .field input, .field select { border: 1px solid var(--panel-line); background: var(--page-bg); color: var(--text-main); border-radius: 8px; padding: 11px 12px; width: 100%; }
  .code-input { font-family: var(--f-mono) !important; font-size: 1.8rem !important; letter-spacing: .4em; text-align: center; }
  .seg { display: flex; gap: 6px; flex-wrap: wrap; }
  .seg button { flex: 1; min-width: 90px; border: 1px solid var(--panel-line); background: transparent; color: var(--text-main); border-radius: 8px; padding: 9px 10px; cursor: pointer; }
  .seg button[aria-pressed="true"] { background: var(--board-bg); color: var(--gold); border-color: var(--board-bg); }
  .btn { border: none; border-radius: 9px; padding: 12px 18px; cursor: pointer; font-weight: 600; background: var(--gold); color: var(--on-gold); }
  .btn:hover:not(:disabled) { background: var(--gold-hi); }
  .btn:disabled { opacity: .45; cursor: not-allowed; }
  .btn.ghost { background: transparent; color: var(--text-main); border: 1px solid var(--panel-line); font-weight: 500; }
  .btn.ghost:hover:not(:disabled) { border-color: var(--coral); color: var(--coral); background: transparent; }
  .btn.dark { background: var(--board-bg-2); color: var(--ink-light); border: 1px solid var(--board-line); }
  .note { font-size: .85rem; color: var(--text-dim); }
  .err { color: var(--coral); font-size: .9rem; font-weight: 500; }
  .rules { margin: 0; padding-left: 18px; color: var(--text-dim); font-size: .9rem; display: flex; flex-direction: column; gap: 4px; }

  /* host */
  .hostbar { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; background: var(--board-bg); color: var(--ink-light); border-radius: 16px; padding: 16px 20px; box-shadow: 0 8px 24px var(--shadow); }
  .codebox { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
  .codebox .big { font-family: var(--f-mono); font-size: clamp(2.4rem, 7vw, 4rem); line-height: 1; color: var(--gold); letter-spacing: .12em; font-weight: 600; }
  .codebox .how { font-size: .9rem; color: var(--ink-light-dim); max-width: 34ch; }
  .codebox .how b { color: var(--ink-light); }
  .qr { background: #fff; padding: 6px; border-radius: 8px; line-height: 0; }
  .qr img, .qr canvas { width: 96px; height: 96px; }
  .hostbar .meta { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .pill { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; border: 1px solid var(--board-line); color: var(--ink-light-dim); border-radius: 999px; padding: 4px 10px; }
  .host-main { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 16px; align-items: start; }
  @media (max-width: 900px) { .host-main { grid-template-columns: minmax(0, 1fr); } }
  .stage { background: var(--board-bg); color: var(--ink-light); border-radius: 16px; padding: 18px; box-shadow: 0 8px 24px var(--shadow); min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .banner { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .banner .who { font-family: var(--f-display); font-size: clamp(1.2rem, 2.6vw, 1.7rem); }
  .banner .who em { font-style: normal; color: var(--gold); }
  .boardscroll { overflow-x: auto; }
  .board { display: grid; grid-template-columns: repeat(5, minmax(110px, 1fr)); gap: 6px; min-width: 580px; }
  .cat-h { background: var(--board-bg-2); border: 1px solid var(--board-line); border-radius: 6px; font-family: var(--f-display); font-weight: 600; font-size: .85rem; text-align: center; padding: 10px 6px; min-height: 64px; display: flex; flex-direction: column; justify-content: center; gap: 3px; text-wrap: balance; }
  .cat-h small { font-family: var(--f-mono); font-size: .62rem; letter-spacing: .08em; color: var(--sage); }
  .tile { background: var(--board-bg-2); border: 1px solid var(--board-line); border-radius: 6px; color: var(--gold); font-family: var(--f-mono); font-weight: 600; font-size: 1.35rem; min-height: 60px; cursor: pointer; }
  .tile:hover:not(:disabled) { background: var(--board-hover); }
  .tile:disabled { background: transparent; border-color: transparent; color: transparent; cursor: default; }
  .tile.static { cursor: default; }
  .qhead { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .qhead .cat { text-transform: uppercase; letter-spacing: .1em; font-size: .78rem; color: var(--gold); font-weight: 600; }
  .timer { font-family: var(--f-mono); font-size: 2rem; color: var(--gold); font-variant-numeric: tabular-nums; min-width: 2.5ch; text-align: right; }
  .timer.low { color: var(--coral); }
  .stem { font-family: var(--f-display); font-size: clamp(1.15rem, 2.4vw, 1.6rem); line-height: 1.45; margin: 0; max-width: 70ch; }
  .qimg { display: block; max-width: 100%; width: 360px; border-radius: 8px; background: #fff; cursor: zoom-in; }
  .qimg.big { width: 100%; max-width: 640px; cursor: zoom-out; }
  .opts { display: flex; flex-direction: column; gap: 8px; }
  .opt { position: relative; display: grid; grid-template-columns: 30px 1fr auto; gap: 10px; align-items: center; padding: 11px 14px; border-radius: 9px; border: 1px solid var(--board-line); background: var(--board-bg-2); overflow: hidden; }
  .opt .lt { font-family: var(--f-mono); color: var(--gold); font-weight: 600; font-size: 1.1rem; }
  .opt .txt { position: relative; z-index: 1; font-size: 1.05rem; }
  .opt .n { position: relative; z-index: 1; font-family: var(--f-mono); color: var(--ink-light-dim); font-size: .9rem; }
  .opt .fill { position: absolute; inset: 0 auto 0 0; background: rgba(232,185,75,.13); z-index: 0; }
  .opt.right { border-color: var(--sage); background: var(--ok-bg); }
  .opt.right .lt { color: var(--sage); }
  .why { border-top: 1px solid var(--board-line); padding-top: 12px; display: flex; flex-direction: column; gap: 8px; }
  .why p { margin: 0; color: var(--ink-light-dim); max-width: 75ch; }
  .why .src { font-size: .8rem; }
  .ctrls { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; align-items: center; }
  .progress { font-family: var(--f-mono); color: var(--ink-light-dim); font-size: .95rem; }
  .rail { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .standings { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .standings li { display: grid; grid-template-columns: 22px 1fr auto auto; gap: 8px; align-items: center; padding: 8px 10px; border-radius: 8px; background: var(--page-bg); border: 1px solid var(--panel-line); }
  .standings li.off { opacity: .5; }
  .standings li.turn { border-color: var(--gold-dim); }
  .standings .rk { font-family: var(--f-mono); color: var(--text-dim); font-size: .85rem; }
  .standings .nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
  .standings .nm small { display: block; color: var(--text-dim); font-weight: 400; font-size: .75rem; }
  .standings .sc { font-family: var(--f-mono); font-weight: 600; font-variant-numeric: tabular-nums; }
  .neg { color: var(--coral); }
  .delta { font-family: var(--f-mono); font-size: .8rem; }
  .delta.up { color: var(--sage); } .delta.down { color: var(--coral); }
  .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; background: var(--sage); }
  .teamcols { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; }
  .teamcol { background: var(--board-bg-2); border: 1px solid var(--board-line); border-radius: 10px; padding: 12px; min-width: 0; }
  .teamcol h3 { font-size: 1rem; color: var(--gold); margin-bottom: 6px; }
  .teamcol ul { margin: 0; padding-left: 16px; color: var(--ink-light-dim); }
  .confirm { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }

  /* phone */
  .phone { max-width: 520px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px; }
  .pbar { display: flex; justify-content: space-between; align-items: center; gap: 10px; background: var(--board-bg); color: var(--ink-light); border-radius: 12px; padding: 10px 14px; }
  .pbar .nm { font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pbar .nm small { display: block; font-weight: 400; color: var(--ink-light-dim); font-size: .75rem; }
  .pbar .sc { font-family: var(--f-mono); font-size: 1.4rem; color: var(--gold); font-weight: 600; }
  .pcard { background: var(--board-bg); color: var(--ink-light); border-radius: 14px; padding: 18px 16px; display: flex; flex-direction: column; gap: 12px; }
  .pcard .stem { font-size: 1.08rem; }
  .pchoices { display: flex; flex-direction: column; gap: 8px; }
  .pchoice { display: grid; grid-template-columns: 28px 1fr; gap: 10px; align-items: center; text-align: left; padding: 14px; min-height: 56px; border-radius: 10px; border: 1px solid var(--board-line); background: var(--board-bg-2); color: var(--ink-light); cursor: pointer; font-size: 1rem; }
  .pchoice .lt { font-family: var(--f-mono); color: var(--gold); font-weight: 600; font-size: 1.1rem; }
  .pchoice:disabled { cursor: default; opacity: .55; }
  .pchoice.mine { opacity: 1; border-color: var(--gold); background: var(--board-hover); }
  .pchoice.right { opacity: 1; border-color: var(--sage); background: var(--ok-bg); }
  .pchoice.wrong { opacity: 1; border-color: var(--coral); background: var(--bad-bg); }
  .pboard { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 4px; }
  .pboard .cat-h { font-size: .62rem; min-height: 54px; padding: 6px 3px; }
  .pboard .cat-h small { display: none; }
  .pboard .tile { font-size: .95rem; min-height: 46px; }
  .big-msg { font-family: var(--f-display); font-size: 1.6rem; line-height: 1.2; }
  .big-msg.ok { color: var(--sage); } .big-msg.bad { color: var(--coral); }
  .center { text-align: center; align-items: center; }
  .teampick { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .teampick button { padding: 16px 10px; border-radius: 10px; border: 1px solid var(--board-line); background: var(--board-bg-2); color: var(--ink-light); font-family: var(--f-display); font-weight: 600; font-size: 1.05rem; cursor: pointer; }
  .wager { display: flex; flex-direction: column; gap: 10px; align-items: center; }
  .wager input[type=range] { width: 100%; accent-color: var(--gold); }
  .wager .amt { font-family: var(--f-mono); font-size: 2.6rem; color: var(--gold); font-weight: 600; }
  details summary { cursor: pointer; color: var(--gold); font-size: .9rem; }
  details ul { margin: 8px 0 0; padding-left: 18px; color: var(--ink-light-dim); font-size: .9rem; display: flex; flex-direction: column; gap: 6px; }
  .podium { display: flex; flex-direction: column; gap: 8px; }
  .podium .row { display: flex; justify-content: space-between; gap: 10px; font-family: var(--f-display); font-size: 1.3rem; padding: 10px 14px; border-radius: 10px; background: var(--board-bg-2); border: 1px solid var(--board-line); }
  .podium .row:first-child { border-color: var(--gold); color: var(--gold); font-size: 1.6rem; }
  @media (prefers-reduced-motion: no-preference) { .pulse { animation: pulse 1.6s ease-in-out infinite; } @keyframes pulse { 50% { opacity: .55; } } }
  [hidden] { display: none !important; }
  img { max-width: 100%; }
</style>
