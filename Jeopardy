  }
  function startFinalQ() { H.phase = "final_q"; H.left = H.timer + 15; H.A = {}; pushHost(); }
  function skipTurn() { advanceChooser(); pushHost(); }

  function hostTick() {
    if (!H || (H.phase !== "question" && H.phase !== "final_q")) return;
    if (H.left > 0) H.left--;
    if (H.left <= 0) reveal(); else pushHost();
  }

  function standingsRows() {
    if (H.mode === "teams") {
      return H.teams.map((name, t) => {
        const mem = Object.keys(H.P).filter(id => H.P[id].t === t);
        const avg = mem.length ? Math.round(mem.reduce((a, id) => a + H.P[id].s, 0) / mem.length) : 0;
        const dl = mem.length ? Math.round(mem.reduce((a, id) => a + (H.last[id] || 0), 0) / mem.length) : 0;
        return { name, sub: mem.length + (mem.length === 1 ? " player" : " players"), s: avg, d: dl, on: mem.some(online), turn: H.ch && H.ch.t === t };
