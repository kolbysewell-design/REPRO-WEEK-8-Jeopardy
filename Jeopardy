  }

  let qrDone = "";
  function renderHost() {
    if (view !== "host" || !H) return;
    const timerEl = document.getElementById("hTimer");
    const key = JSON.stringify([H.phase, H.round, H.q, H.used, H.ch, H.P, Object.keys(SEEN).sort(), H.A, H.W, H.dist, hostErr, confirmEnd]);
    if (timerEl && renderHost.key === key) { timerEl.textContent = H.left; timerEl.classList.toggle("low", H.left <= 5); return; }
    renderHost.key = key;
    const players = Object.keys(H.P);
    const howJoin = JOIN_URL ? `Scan the code, or go to <b>${esc(JOIN_URL.replace(/^https?:\/\//, ""))}</b> and enter` : "Open this page on your phone, choose <b>Join</b>, enter";
    let stage = "";
    const banner = (who, right) => `<div class="banner"><div class="who">${who}</div><div class="ctrls">${right || ""}</div></div>`;
    if (H.phase === "lobby") {
      const groups = H.mode === "teams"
        ? `<div class="teamcols">${H.teams.map((t, i) => `<div class="teamcol"><h3>${esc(t)}</h3><ul>${players.filter(id => H.P[id].t === i).map(id => `<li>${esc(H.P[id].n)}</li>`).join("") || '<li style="list-style:none;margin-left:-16px">No one yet</li>'}</ul></div>`).join("")}
           ${players.some(id => H.P[id].t < 0) ? `<div class="teamcol"><h3>Picking a team</h3><ul>${players.filter(id => H.P[id].t < 0).map(id => `<li>${esc(H.P[id].n)}</li>`).join("")}</ul></div>` : ""}</div>`
        : `<div class="teamcols"><div class="teamcol"><h3>Players</h3><ul>${players.map(id => `<li>${esc(H.P[id].n)}</li>`).join("") || '<li style="list-style:none;margin-left:-16px">No one yet</li>'}</ul></div></div>`;
      const ready = eligiblePids().length > 0;
      stage = banner(`Waiting for players · <em>${eligiblePids().length}</em> ready`, `<button class="btn" id="hStart" ${ready ? "" : "disabled"}>Start game</button>`) + groups;
    } else if (H.phase === "choose") {
      stage = banner(`<em>${esc(chooserLabel())}</em> is choosing a clue`, `<button class="btn dark" id="hSkip">Skip turn</button>`) +
        `<p class="note" style="color:var(--ink-light-dim);margin:0">They pick on their phone. You can also tap a tile here for them.</p>` + boardHTML(true);
    } else if (H.phase === "question" || H.phase === "final_q" || H.phase === "reveal" || H.phase === "final_reveal") {
      const isF = H.phase === "final_q" || H.phase === "final_reveal";
      const shown = H.phase === "reveal" || H.phase === "final_reveal";
      const { c, q, v } = clue(isF ? "F" : H.q);
      const total = H.dist ? H.dist.reduce((a, b) => a + b, 0) : 0;
      stage = `<div class="qhead"><span class="cat">${esc(c.name)}${isF ? "" : " · $" + v}</span>
          ${shown ? `<span class="progress">${total} answered</span>` : `<span class="progress">${Object.keys(H.A).length}/${eligiblePids().length} locked in</span><span class="timer${H.left <= 5 ? " low" : ""}" id="hTimer">${H.left}</span>`}</div>
        <p class="stem">${esc(q.stem)}</p>
        ${q.img ? `<img class="qimg" id="hImg" alt="Diagram of the canine left ovary, uterine horn and ligaments with five lettered structures" src="${IMG_LIG}">` : ""}
        <div class="opts">${q.ch.map((t, i) => `<div class="opt${shown && i === q.a ? " right" : ""}">${shown && total ? `<span class="fill" style="width:${Math.round(100 * H.dist[i] / total)}%"></span>` : ""}<span class="lt">${LET[i]}</span><span class="txt">${esc(t)}</span><span class="n">${shown ? H.dist[i] : ""}</span></div>`).join("")}</div>
        ${shown ? `<div class="why"><p><strong style="color:var(--sage)">${LET[q.a]}. ${esc(q.ch[q.a])}.</strong> ${esc(q.why)}</p><p class="src">${esc(q.src)}</p></div>` : ""}
        <div class="ctrls">${shown
          ? (H.phase === "final_reveal" ? `<button class="btn" id="hOver">Show final standings</button>` : `<button class="btn" id="hNext">${H.used.includes("0") ? "Next turn" : "On to Final Jeopardy"}</button>`)
          : `<button class="btn dark" id="hReveal">Reveal now</button>`}</div>`;
    } else if (H.phase === "final_wager") {
      stage = banner(`Final Jeopardy · <em>${esc(FINAL_CAT)}</em>`, `<button class="btn" id="hFinalGo">Show the clue</button>`) +
        `<p style="margin:0;color:var(--ink-light-dim)">Everyone wagers on their phone, up to their own score. Players at $0 or below can only wager $0. <b style="color:var(--ink-light)">${Object.keys(H.W).length}/${eligiblePids().length}</b> wagers locked. Anyone who doesn't lock a wager plays for $0.</p>`;
    } else if (H.phase === "over") {
      const rows = standingsRows();
      stage = `<div class="banner"><div class="who">Final standings</div></div><div class="podium">${rows.map(r => `<div class="row"><span>${esc(r.name)}</span><span class="tnum">${fmt(r.s)}</span></div>`).join("")}</div>
        <div class="ctrls"><button class="btn ghost" id="hHome" style="color:var(--ink-light)">Back to start</button></div>`;
    }
    const rows = standingsRows();
    app.innerHTML = `
      <div class="hostbar">
        <div class="codebox">
          <div><p class="eyebrow" style="color:var(--ink-light-dim)">Game code</p><div class="big">${esc(H.code)}</div></div>
          <p class="how">${howJoin} the code and your name.</p>
          ${JOIN_URL ? '<div class="qr" id="qr" aria-label="QR code linking to this game"></div>' : ""}
        </div>
        <div class="meta"><span class="pill">${H.mode === "teams" ? H.teams.length + " teams" : "Players"}</span><span class="pill">${H.timer}s clues</span><span class="pill">${H.used.split("").filter(x => x === "1").length}/25 played</span></div>
      </div>
      ${hostErr ? `<p class="err">${esc(hostErr)}</p>` : ""}
      <div class="host-main">
        <section class="stage" aria-live="polite">${stage}</section>
        <aside class="rail card">
          <h2>${H.mode === "teams" ? "Team standings" : "Standings"}</h2>
          <ol class="standings">${rows.map((r, i) => `<li class="${r.on ? "" : "off"}${r.turn ? " turn" : ""}"><span class="rk">${i + 1}</span><span class="nm">${esc(r.name)}${r.sub ? `<small>${r.sub}</small>` : ""}</span><span class="delta ${r.d > 0 ? "up" : r.d < 0 ? "down" : ""}">${(H.phase === "reveal" || H.phase === "final_reveal") && r.d ? sgn(r.d) : ""}</span><span class="sc ${r.s < 0 ? "neg" : ""}">${fmt(r.s)}</span></li>`).join("") || '<li style="grid-template-columns:1fr"><span class="dim">No players yet</span></li>'}</ol>
          <div class="confirm">${confirmEnd
            ? `<span class="note">End this game for everyone?</span><button class="btn" id="hEndYes" style="background:var(--coral);color:var(--on-coral)">End game</button><button class="btn ghost" id="hEndNo">Keep playing</button>`
            : `<button class="btn ghost" id="hEnd">End game</button>`}</div>
        </aside>
      </div>`;
    if (JOIN_URL && window.QRCode) { try { new QRCode(document.getElementById("qr"), { text: JOIN_URL + "?code=" + H.code, width: 192, height: 192, correctLevel: QRCode.CorrectLevel.M }); } catch (e) {} }
    const on = (id, fn) => { const b = document.getElementById(id); if (b) b.onclick = fn; };
    on("hStart", startGame); on("hSkip", skipTurn); on("hReveal", reveal); on("hNext", nextClue);
    on("hFinalGo", startFinalQ); on("hOver", () => { H.phase = "over"; pushHost(); });
    on("hEnd", () => { confirmEnd = true; renderHost(); }); on("hEndNo", () => { confirmEnd = false; renderHost(); });
    on("hEndYes", () => { confirmEnd = false; H.phase = "over"; pushHost(); });
    on("hHome", () => { store.del(HOST_KEY); clearInterval(hostTimer); if (peer) { try { peer.destroy(); } catch (e) {} } peer = null; for (const k in CONNS) delete CONNS[k]; for (const k in PSTATE) delete PSTATE[k]; H = null; renderHome(); });
    const img = document.getElementById("hImg"); if (img) img.onclick = () => img.classList.toggle("big");
    app.querySelectorAll(".tile[data-k]").forEach(b => b.onclick = () => startQuestion(b.dataset.k));
  }

  function boardHTML(clickable, used) {
    used = used || H.used;
    let h = CATS.map(c => `<div class="cat-h"><small>${c.lec}</small>${esc(c.name)}</div>`).join("");
    for (let r = 0; r < 5; r++) for (let ci = 0; ci < 5; ci++) {
      const k = ci + "-" + r, u = used[tileIdx(k)] === "1";
      h += `<button class="tile${clickable ? "" : " static"}" ${u || !clickable ? "disabled" : ""} ${clickable && !u ? `data-k="${k}"` : ""} aria-label="${esc(CATS[ci].name)} for $${VALUES[r]}${u ? ", played" : ""}">${u ? "" : "$" + VALUES[r]}</button>`;
    }
    return `<div class="boardscroll"><div class="board">${h}</div></div>`;
  }
  const VALUES = [100, 200, 300, 400, 500];

  /* =====================================================================
     PHONE — reads the host's presence, answers through its own presence
     ===================================================================== */
  let lookedLong = false;
  let ME = null, G = null, hostSeen = false, myAns = {}, myPick = {}, myWager = {}, phoneErr = "", lookTimer = null;

  async function joinGame(code, name) {
    const prev = store.get(ME_KEY) || {};
    ME = { pid: prev.pid || pid(), n: name, code, t: prev.code === code && Number.isInteger(prev.t) ? prev.t : -1 };
    store.set(ME_KEY, ME);
    view = "phone"; G = null; hostSeen = false; phoneErr = "";
    app.innerHTML = '<p class="note pulse">Joining game ' + esc(code) + '…</p>';
    ME_PR = { role: "player", pid: ME.pid, n: ME.n, t: ME.t };
    connectPhone();
    clearTimeout(lookTimer);
    lookedLong = false;
    lookTimer = setTimeout(() => { lookedLong = true; if (!hostSeen) renderPhone(true); }, 7000);
    renderPhone(true);
  }
  let ppeer = null, conn = null, ME_PR = {}, retryT = null;
  function connectPhone() {
    if (!ppeer || ppeer.destroyed) {
      ppeer = new Peer(peerOpts());
      ppeer.on("error", e => {
        if (e.type === "peer-unavailable") { lookedLong = true; if (!hostSeen) renderPhone(true); scheduleRetry(); }
        else if (e.type === "browser-incompatible") { phoneErr = "This browser can't join. Try Chrome or Safari."; renderPhone(true); }
        else if (["network", "server-error", "socket-error", "socket-closed"].includes(e.type)) { scheduleRetry(); }
      });
      ppeer.on("disconnected", () => { setTimeout(() => { try { if (ppeer && !ppeer.destroyed) ppeer.reconnect(); } catch (e) {} }, 1500); });
    }
    const go = () => {
      if (view !== "phone") return;
      const c = ppeer.connect(PEER_PREFIX + ME.code, { reliable: true });
      conn = c;
      c.on("open", () => { c.send({ t: "pr", pr: ME_PR }); });
      c.on("data", m => { if (conn === c && m && m.t === "g" && m.g && m.g.code === ME.code) { G = m.g; hostSeen = true; renderPhone(false); } });
      c.on("close", () => { if (conn === c && view === "phone") { G = null; renderPhone(true); scheduleRetry(); } });
      c.on("error", () => {});
    };
    if (ppeer.open) go(); else ppeer.once("open", go);
  }
  function scheduleRetry() {
    clearTimeout(retryT);
    retryT = setTimeout(() => { if (view === "phone" && !(conn && conn.open)) connectPhone(); }, 3000);
  }
  function sendMe(extra) {
    Object.assign(ME_PR, { n: ME.n, t: ME.t }, extra || {});
    if (conn && conn.open) { try { conn.send({ t: "pr", pr: ME_PR }); } catch (e) {} }
  }
  function onPhonePeers(change) {
    let best = null;
    for (const p of change.peers) {
      const pr = p.presence || {};
      if (pr.role === "host" && pr.g && pr.g.code === ME.code && (!best || p.updatedAt > best.updatedAt)) best = p;
    }
    if (best) { G = best.presence.g; hostSeen = true; } else if (hostSeen) { G = null; }
    renderPhone(false);
  }

  function myScore() { return G && G.P && G.P[ME.pid] ? G.P[ME.pid][2] : 0; }
  function amChooser() {
    if (!G || !G.ch) return false;
    return G.mode === "teams" ? ME.t === G.ch.t : G.ch.p === ME.pid;
  }
  function gChooserLabel() {
    if (!G || !G.ch) return "Someone";
    if (G.mode === "teams") return (G.teams && G.teams[G.ch.t]) || "A team";
    return (G.P && G.P[G.ch.p] && G.P[G.ch.p][0]) || "A player";
  }
  function phoneStandings() {
    if (!G || !G.P) return [];
    const ids = Object.keys(G.P);
    if (G.mode === "teams") return (G.teams || []).map((name, t) => {
      const mem = ids.filter(id => G.P[id][1] === t);
      return { name, s: mem.length ? Math.round(mem.reduce((a, id) => a + G.P[id][2], 0) / mem.length) : 0, me: ME.t === t };
    }).sort((a, b) => b.s - a.s);
    return ids.map(id => ({ name: G.P[id][0], s: G.P[id][2], me: id === ME.pid })).sort((a, b) => b.s - a.s);
  }

  function renderPhone(force) {
    if (view !== "phone") return;
    const timerEl = document.getElementById("pTimer");
    const key = JSON.stringify([G && [G.phase, G.round, G.q, G.used, G.ch, G.P, G.last, G.teams, G.mode, G.w], hostSeen, ME.t, myAns, myPick, myWager, phoneErr]);
    if (!force && timerEl && renderPhone.key === key) { timerEl.textContent = G ? G.left : ""; timerEl.classList.toggle("low", G && G.left <= 5); return; }
    if (!force && renderPhone.key === key) return;
    renderPhone.key = key;

    const teamName = G && G.mode === "teams" && ME.t >= 0 && G.teams ? G.teams[ME.t] : "";
    const top = `<div class="pbar"><span class="nm">${esc(ME.n)}${teamName ? `<small>${esc(teamName)}</small>` : ""}</span><span class="sc ${myScore() < 0 ? "neg" : ""}">${fmt(myScore())}</span></div>`;
    let body = "";
    const leave = `<button class="btn ghost" id="pLeave">Leave game</button>`;

    if (phoneErr) body = `<div class="card"><p class="err">${esc(phoneErr)}</p>${leave}</div>`;
    else if (!G) {
      body = hostSeen
        ? `<div class="pcard center"><p class="big-msg">The host left the game.</p><p style="margin:0;color:var(--ink-light-dim)">If they reopen it with the same code, you'll reconnect here.</p></div>`
        : `<div class="pcard center"><p class="big-msg pulse">Looking for game ${esc(ME.code)}…</p><p style="margin:0;color:var(--ink-light-dim)">${lookedLong ? "No game with this code is running yet. Check the code on the host screen." : "Hang tight."}</p></div>`;
    } else if (G.mode === "teams" && !(ME.t >= 0 && ME.t < (G.teams || []).length)) {
      body = `<div class="pcard"><p class="big-msg">Pick your team</p><div class="teampick">${(G.teams || []).map((t, i) => `<button data-team="${i}">${esc(t)}</button>`).join("")}</div></div>`;
    } else {
      const ph = G.phase;
      if (ph === "lobby") {
        const n = Object.keys(G.P || {}).length;
        body = `<div class="pcard center"><p class="big-msg">You're in.</p><p style="margin:0;color:var(--ink-light-dim)">${n} ${n === 1 ? "player has" : "players have"} joined. Watch the big screen. The host starts when everyone's ready.</p>
          ${G.mode === "teams" ? `<button class="btn dark" id="pSwitch">Switch team</button>` : ""}</div>`;
      } else if (ph === "choose") {
        if (amChooser()) {
          const picked = myPick[G.round];
          body = `<div class="pcard"><p class="big-msg">${G.mode === "teams" ? "Your team picks." : "Your pick."}</p><p style="margin:0;color:var(--ink-light-dim)">${picked ? "Sent. Waiting for the host…" : "Tap a tile. The first tap from your " + (G.mode === "teams" ? "team" : "phone") + " counts."}</p>
            ${phoneBoard(!picked)}</div>`;
        } else {
          body = `<div class="pcard center"><p class="big-msg">${esc(gChooserLabel())} is choosing…</p><p style="margin:0;color:var(--ink-light-dim)">Get ready to answer.</p></div>`;
        }
      } else if (ph === "question" || ph === "final_q") {
        const isF = ph === "final_q";
        const cl = clue(isF ? "F" : G.q);
        if (!cl) body = `<div class="pcard"><p class="big-msg">Loading clue…</p></div>`;
        else {
          const mine = myAns[G.round];
          body = `<div class="pcard"><div class="qhead"><span class="cat">${esc(cl.c.name)}${isF ? " · wager " + fmt(myWager[G.round] || 0) : " · $" + cl.v}</span><span class="timer${G.left <= 5 ? " low" : ""}" id="pTimer">${G.left}</span></div>
            <p class="stem">${esc(cl.q.stem)}</p>
            ${cl.q.img ? `<img class="qimg" id="pImg" alt="Diagram of the canine left ovary, uterine horn and ligaments with five lettered structures" src="${IMG_LIG}">` : ""}
            <div class="pchoices">${cl.q.ch.map((t, i) => `<button class="pchoice${mine === i ? " mine" : ""}" data-c="${i}" ${mine != null ? "disabled" : ""}><span class="lt">${LET[i]}</span><span>${esc(t)}</span></button>`).join("")}</div>
            ${mine != null ? `<p style="margin:0;color:var(--ink-light-dim)">Locked in. Waiting for everyone else.</p>` : ""}</div>`;
        }
      } else if (ph === "reveal" || ph === "final_reveal") {
        const isF = ph === "final_reveal";
        const cl = clue(isF ? "F" : G.q);
        const d = G.last && G.last[ME.pid] != null ? G.last[ME.pid] : 0;
        const mine = myAns[G.round];
        const ok = mine === cl.q.a;
        const msg = mine == null ? `<p class="big-msg">No answer · $0</p>` : ok ? `<p class="big-msg ok">Correct! ${sgn(d)}</p>` : `<p class="big-msg bad">Not this time. ${sgn(d)}</p>`;
        body = `<div class="pcard">${msg}
          <div class="pchoices">${cl.q.ch.map((t, i) => `<button class="pchoice${i === cl.q.a ? " right" : mine === i ? " wrong" : ""}" disabled><span class="lt">${LET[i]}</span><span>${esc(t)}</span></button>`).join("")}</div>
          <p style="margin:0;color:var(--ink-light-dim)">${esc(cl.q.why)}</p>
          <details><summary>Why the other choices are wrong</summary><ul>${cl.q.ch.map((t, i) => i === cl.q.a ? "" : `<li><b>${LET[i]}. ${esc(t)}.</b> ${esc(cl.q.wr[i] || "")}</li>`).join("")}</ul></details>
          <p style="margin:0;font-size:.8rem;color:var(--ink-light-dim)">${esc(cl.q.src)}</p></div>` + standingsCard();
      } else if (ph === "final_wager") {
        const max = Math.max(0, myScore());
        const locked = myWager[G.round];
        body = `<div class="pcard"><p class="eyebrow" style="color:var(--gold)">Final Jeopardy · ${esc(FINAL_CAT)}</p>
          ${locked != null ? `<p class="big-msg">Wager locked: ${fmt(locked)}</p><p style="margin:0;color:var(--ink-light-dim)">Waiting for the host to show the clue.</p>`
          : max === 0 ? `<p class="big-msg">You play this one for $0.</p><p style="margin:0;color:var(--ink-light-dim)">Your score is at or below $0, so there's nothing to wager. You can still answer.</p><button class="btn" id="pWager0">Got it</button>`
          : `<div class="wager"><p style="margin:0;color:var(--ink-light-dim)">Wager up to ${fmt(max)}.</p><div class="amt" id="wAmt">${fmt(Math.min(max, 500))}</div>
              <input type="range" id="wRange" min="0" max="${max}" step="50" value="${Math.min(max, 500)}" aria-label="Wager amount">
              <button class="btn" id="pWager">Lock wager</button></div>`}</div>`;
      } else if (ph === "over") {
        const rows = phoneStandings();
        body = `<div class="pcard"><p class="big-msg">Game over</p><div class="podium">${rows.map(r => `<div class="row"><span>${esc(r.name)}${r.me ? " (you)" : ""}</span><span class="tnum">${fmt(r.s)}</span></div>`).join("")}</div></div>`;
      }
    }
    app.innerHTML = `<div class="phone">${top}${body}<div class="ctrls" style="justify-content:center">${phoneErr ? "" : leave}</div></div>`;

    app.querySelectorAll("[data-team]").forEach(b => b.onclick = () => { ME.t = +b.dataset.team; store.set(ME_KEY, ME); sendMe(); renderPhone(true); });
    const sw = document.getElementById("pSwitch"); if (sw) sw.onclick = () => { ME.t = -1; store.set(ME_KEY, ME); sendMe(); renderPhone(true); };
    app.querySelectorAll(".pboard .tile[data-k]").forEach(b => b.onclick = () => { myPick[G.round] = b.dataset.k; sendMe({ pick: { at: G.round, k: b.dataset.k } }); renderPhone(true); });
    app.querySelectorAll(".pchoice[data-c]").forEach(b => b.onclick = () => { if (myAns[G.round] != null) return; myAns[G.round] = +b.dataset.c; sendMe({ ans: { at: G.round, c: +b.dataset.c } }); renderPhone(true); });
    const rg = document.getElementById("wRange"); if (rg) rg.oninput = () => { document.getElementById("wAmt").textContent = fmt(+rg.value); };
    const wb = document.getElementById("pWager"); if (wb) wb.onclick = () => { const w = +rg.value; myWager[G.round] = w; sendMe({ wager: { at: G.round, w } }); renderPhone(true); };
    const w0 = document.getElementById("pWager0"); if (w0) w0.onclick = () => { myWager[G.round] = 0; sendMe({ wager: { at: G.round, w: 0 } }); renderPhone(true); };
    const img = document.getElementById("pImg"); if (img) img.onclick = () => img.classList.toggle("big");
    const lv = document.getElementById("pLeave"); if (lv) lv.onclick = () => { clearTimeout(retryT); if (conn) { try { conn.close(); } catch (e) {} } conn = null; if (ppeer) { try { ppeer.destroy(); } catch (e) {} } ppeer = null; G = null; hostSeen = false; myAns = {}; myPick = {}; myWager = {}; clearTimeout(lookTimer); renderHome(); };
  }
  function phoneBoard(clickable) {
    let h = CATS.map(c => `<div class="cat-h">${esc(c.name)}</div>`).join("");
    for (let r = 0; r < 5; r++) for (let ci = 0; ci < 5; ci++) {
      const k = ci + "-" + r, u = G.used[tileIdx(k)] === "1";
      h += `<button class="tile" ${u || !clickable ? "disabled" : ""} data-k="${k}" aria-label="${esc(CATS[ci].name)} for $${VALUES[r]}">${u ? "" : VALUES[r]}</button>`;
    }
    return `<div class="pboard">${h}</div>`;
  }
  function standingsCard() {
    const rows = phoneStandings();
    return `<div class="card"><h2>${G.mode === "teams" ? "Team standings" : "Standings"}</h2><ol class="standings">${rows.map((r, i) => `<li${r.me ? ' class="turn"' : ""}><span class="rk">${i + 1}</span><span class="nm">${esc(r.name)}${r.me ? " (you)" : ""}</span><span></span><span class="sc ${r.s < 0 ? "neg" : ""}">${fmt(r.s)}</span></li>`).join("")}</ol></div>`;
  }

  renderHome();
})();
</script>
</body>
</html>
