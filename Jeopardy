    openHostPeer(0);
  }

  let peer = null; const CONNS = {}, PSTATE = {};
  function hostProcess() { onHostPeers({ peers: Object.keys(PSTATE).map(id => ({ presence: PSTATE[id] })) }); }
  function sendG(conn) { try { if (conn.open) conn.send({ t: "g", g: buildG() }); } catch (e) {} }
  function openHostPeer(tries) {
    if (peer) { try { peer.destroy(); } catch (e) {} }
    peer = new Peer(PEER_PREFIX + H.code, peerOpts());
    peer.on("open", () => { hostErr = ""; clearInterval(hostTimer); hostTimer = setInterval(hostTick, 1000); pushHost(); });
    peer.on("connection", conn => {
      conn.on("data", m => {
        if (!m || m.t !== "pr" || !m.pr || typeof m.pr.pid !== "string" || !/^p[a-z0-9]{4,12}$/.test(m.pr.pid)) return;
        const id = m.pr.pid;
        if (CONNS[id] && CONNS[id] !== conn) { try { CONNS[id].close(); } catch (e) {} }
        CONNS[id] = conn; conn._pid = id;
        PSTATE[id] = Object.assign({}, m.pr, { role: "player" });
        hostProcess(); sendG(conn);
      });
      conn.on("close", () => { const id = conn._pid; if (id && CONNS[id] === conn) { delete CONNS[id]; delete PSTATE[id]; hostProcess(); } });
      conn.on("error", () => {});
    });
    peer.on("disconnected", () => { setTimeout(() => { try { if (peer && !peer.destroyed) peer.reconnect(); } catch (e) {} }, 1500); });
    peer.on("error", e => {
      if (e.type === "unavailable-id") {
        if (H.phase !== "lobby" && tries < 6) { hostErr = "Reclaiming game code " + H.code + "…"; renderHost(); setTimeout(() => openHostPeer(tries + 1), 3000); }
        else { H.code = String(Math.floor(1000 + Math.random() * 9000)); openHostPeer(tries + 1); }
      } else if (e.type === "browser-incompatible") { hostErr = "This browser can't host. Use Chrome, Edge, Safari or Firefox."; renderHost(); }
      else if (["network", "server-error", "socket-error", "socket-closed"].includes(e.type)) { hostErr = "Connection trouble. Retrying…"; renderHost(); setTimeout(() => { if (H && view === "host") openHostPeer(tries + 1); }, 4000); }
    });
  }

  function online(pid) { return !!SEEN[pid]; }
  function teamOf(pid) { const p = H.P[pid]; return p ? p.t : -1; }
  function eligible(pid) { return online(pid) && (H.mode !== "teams" || (teamOf(pid) >= 0 && teamOf(pid) < H.teams.length)); }
  function eligiblePids() { return Object.keys(H.P).filter(eligible); }

  function onHostPeers(change) {
    const seen = {};
    let changed = false;
    for (const p of change.peers) {
      const pr = p.presence || {};
      if (pr.role !== "player" || typeof pr.pid !== "string" || !/^p[a-z0-9]{4,12}$/.test(pr.pid)) continue;
      const id = pr.pid;
      if (!H.P[id]) {
        if (Object.keys(H.P).length >= 30) continue;
        H.P[id] = { n: clean(pr.n) || "Player", t: -1, s: 0 }; H.order.push(id); changed = true;
      }
      seen[id] = pr;
      const P = H.P[id], n = clean(pr.n) || P.n;
      if (n !== P.n) { P.n = n; changed = true; }
      const t = Number.isInteger(pr.t) && pr.t >= 0 && pr.t < H.teams.length ? pr.t : -1;
      if (H.mode === "teams" && t !== P.t && t >= 0) { P.t = t; changed = true; }
    }
    const before = Object.keys(SEEN).sort().join(), after = Object.keys(seen).sort().join();
    if (before !== after) changed = true;
    SEEN = seen;

    if (H.phase === "choose") {
      if (!chooserValid()) { const was = JSON.stringify(H.ch); advanceChooser(); if (JSON.stringify(H.ch) !== was) changed = true; }
      for (const id in SEEN) {
        const pk = SEEN[id].pick;
        if (pk && pk.at === H.round && isChooser(id) && tileKeys.includes(pk.k) && H.used[tileIdx(pk.k)] === "0") { startQuestion(pk.k); return; }
      }
    }
    if (H.phase === "question" || H.phase === "final_q") {
      for (const id in SEEN) {
        const a = SEEN[id].ans;
        if (a && a.at === H.round && H.A[id] == null && Number.isInteger(a.c) && a.c >= 0 && a.c < 5) { H.A[id] = a.c; changed = true; }
      }
      const el = eligiblePids();
      if (el.length && el.every(id => H.A[id] != null)) { reveal(); return; }
    }
    if (H.phase === "final_wager") {
      for (const id in SEEN) {
        const w = SEEN[id].wager;
        if (w && w.at === H.round && Number.isFinite(w.w)) {
          const v = Math.max(0, Math.min(Math.round(w.w), Math.max(0, H.P[id].s)));
